{
  "manifestVersion": 2,
  "id": "doc-intake",
  "name": "Doc Intake",
  "version": "2.5.0",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "minAppVersion": "0.978.0",
  "description": "文档/图片内容提取。PDF（MinerU/PaddleOCR/本地）、图片 OCR、Office（DOC/DOCX/PPT/PPTX/XLS/XLSX/XLSM/HTML）转结构化 Markdown，含公式转 LaTeX、EMF 转 PNG、媒体提取。",
  "capabilities": [
    "app/process.spawn",
    "app/tools.expose-to-model"
  ],
  "contributes": {
    "settings": {
      "title": "Doc Intake 设置",
      "schema": {
        "properties": {
          "pythonPath": {
            "type": "string",
            "title": "Python 可执行文件路径",
            "default": "",
            "description": "conda 环境的 python.exe 路径，例如 <conda 目录>/envs/<环境名>/python.exe"
          },
          "defaultBackend": {
            "type": "string",
            "title": "默认解析后端",
            "enum": ["auto", "mineru", "paddleocr", "local"],
            "default": "auto"
          },
          "pdfBackendChain": {
            "type": "string",
            "title": "PDF 后端降级链",
            "default": "",
            "description": "留空 = 自动 mineru>paddleocr>local。也可显式填写，按顺序尝试，失败自动降级到下一档。用 > 或 ; 分隔，例如 mineru>paddleocr>local"
          },
          "mineruCredentials": {
            "type": "string",
            "title": "MinerU Token",
            "default": "",
            "description": "多个用分号分隔。获取地址：https://mineru.net/apiManage/token"
          },
          "mineruModelVersion": {
            "type": "string",
            "title": "MinerU 模型版本",
            "enum": ["vlm", "pipeline", "MinerU-HTML"],
            "default": "vlm"
          },
          "mineruEnableOCR": {
            "type": "boolean",
            "title": "MinerU 开启 OCR",
            "default": true
          },
          "mineruEnableFormula": {
            "type": "boolean",
            "title": "MinerU 开启公式识别",
            "default": true
          },
          "mineruEnableTable": {
            "type": "boolean",
            "title": "MinerU 开启表格识别",
            "default": true
          },
          "paddleTokens": {
            "type": "string",
            "title": "PaddleOCR Token",
            "default": "",
            "description": "多个用分号分隔。获取地址：https://aistudio.baidu.com/account/accessToken"
          },
          "paddleUseDocOrientationClassify": {
            "type": "boolean",
            "title": "PaddleOCR 文档方向分类",
            "default": false
          },
          "paddleUseDocUnwarping": {
            "type": "boolean",
            "title": "PaddleOCR 文档去扭曲",
            "default": true
          },
          "paddleUseChartRecognition": {
            "type": "boolean",
            "title": "PaddleOCR 图表识别",
            "default": true
          },
          "paddleUseSealRecognition": {
            "type": "boolean",
            "title": "PaddleOCR 印章识别",
            "default": false
          },
          "paddleUseTableRecognition": {
            "type": "boolean",
            "title": "PaddleOCR 表格识别",
            "default": true
          },
          "paddleUseFormulaRecognition": {
            "type": "boolean",
            "title": "PaddleOCR 公式识别",
            "default": true
          },
          "splitImageThreshold": {
            "type": "number",
            "title": "图片分割阈值（高度/宽度超过此值才分割）",
            "default": 1.2
          },
          "splitImageTolerance": {
            "type": "number",
            "title": "图片分割色差容忍度",
            "default": 15
          },
          "splitImageBlankRatio": {
            "type": "number",
            "title": "图片分割空白行像素比例阈值",
            "default": 0.98
          },
          "splitImageMinBlank": {
            "type": "number",
            "title": "图片分割最小连续空白行数",
            "default": 5
          },
          "maxConcurrent": {
            "type": "number",
            "title": "云端 API 并发限",
            "default": 4
          },
          "maxConcurrentLocal": {
            "type": "number",
            "title": "本地后端并发限",
            "default": 8
          },
          "legacyConversionProvider": {
            "type": "string",
            "title": "旧版 Office 转换后端（.doc/.xls/.ppt）",
            "enum": ["auto", "office_com", "libreoffice", "disabled"],
            "default": "auto"
          },
          "libreOfficePath": {
            "type": "string",
            "title": "LibreOffice 可执行文件路径",
            "default": "",
            "description": "仅 legacyConversionProvider 为 libreoffice（或 auto 且无 Office COM）时使用"
          },
          "legacyConversionConcurrency": {
            "type": "number",
            "title": "旧版 Office 转换并发限",
            "default": 1
          },
          "legacyConversionTimeoutMs": {
            "type": "number",
            "title": "旧版 Office 转换超时（毫秒）",
            "default": 180000
          },
          "maxRetries": {
            "type": "number",
            "title": "API 临时错误最大重试次数",
            "default": 3
          },
          "retryBaseDelayMs": {
            "type": "number",
            "title": "重试基础退避毫秒",
            "default": 1000
          },
          "maxRemoteImagesPerHtml": {
            "type": "number",
            "title": "HTML 最多下载远程图片数",
            "default": 100
          },
          "defaultLanguage": {
            "type": "string",
            "title": "默认语言（zh/en 等）",
            "default": "zh"
          },
          "includeMedia": {
            "type": "boolean",
            "title": "默认提取媒体（图片/视频/音频）",
            "default": true
          },
          "mineruFlashMaxMB": {
            "type": "number",
            "title": "MinerU Flash 最大文件大小(MB)",
            "default": 10
          },
          "mineruFlashMaxPages": {
            "type": "number",
            "title": "MinerU Flash 最大页数",
            "default": 20
          },
          "mineruPrecisionMaxMB": {
            "type": "number",
            "title": "MinerU Precision 最大文件大小(MB)",
            "default": 200
          },
          "mineruPrecisionMaxPages": {
            "type": "number",
            "title": "MinerU Precision 最大页数",
            "default": 200
          },
          "autoSplitLargePDF": {
            "type": "boolean",
            "title": "自动切割超限 PDF",
            "default": true
          },
          "splitChunkPages": {
            "type": "number",
            "title": "切割时每块页数",
            "default": 180
          },
          "keyRetryOnFailure": {
            "type": "boolean",
            "title": "Key 失败时自动重试下一个",
            "default": true
          },
          "notifyKeyFailure": {
            "type": "boolean",
            "title": "Key 失效时通知用户",
            "default": true
          },
          "saveJson": {
            "type": "boolean",
            "title": "默认保存结构化 JSON",
            "default": false
          },
          "inlineBlockBytes": {
            "type": "number",
            "title": "每个返回文本块的最大大小（字节，代码内限 4096-30720）",
            "default": 28672
          },
          "inlineBlockCount": {
            "type": "number",
            "title": "返回文本块数量上限（代码内限 1-8）",
            "default": 4
          },
          "mediaPathReturnLimit": {
            "type": "number",
            "title": "Agent 返回媒体绝对路径数量上限",
            "default": 20
          },
          "logLevel": {
            "type": "string",
            "title": "日志级别",
            "enum": ["DEBUG", "INFO", "WARNING", "ERROR"],
            "default": "INFO"
          },
          "logFile": {
            "type": "string",
            "title": "日志文件路径（留空则只输出到控制台）",
            "default": ""
          },
          "htmlExtractMetadata": {
            "type": "boolean",
            "title": "HTML: 提取元数据",
            "default": true
          },
          "htmlExtractLinks": {
            "type": "boolean",
            "title": "HTML: 提取链接列表",
            "default": true
          },
          "htmlExtractImages": {
            "type": "boolean",
            "title": "HTML: 提取并下载图片",
            "default": true
          },
          "htmlExtractCodeBlocks": {
            "type": "boolean",
            "title": "HTML: 提取代码块",
            "default": true
          },
          "htmlHeadingStyle": {
            "type": "string",
            "title": "HTML: 标题风格",
            "enum": ["ATX", "SETEXT"],
            "default": "ATX"
          },
          "xlsxMaxRows": {
            "type": "number",
            "title": "Excel 最大提取行数（0 表示不限制）",
            "default": 100
          },
          "xlsxMaxCols": {
            "type": "number",
            "title": "Excel 最大提取列数（0 表示不限制）",
            "default": 50
          },
          "autoSave": {
            "type": "boolean",
            "title": "默认自动保存到本地",
            "default": false
          },
          "savePath": {
            "type": "string",
            "title": "默认保存路径",
            "default": "",
            "description": "留空就用系统文档目录下的 doc-intake（不写死盘符，按各自的机器算）"
          }
        }
      }
    }
  }
}
